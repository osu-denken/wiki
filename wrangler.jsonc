{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "denken-wiki",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "wiki.osu-denken.net", "custom_domain": true }
  ],
  "assets": {
    // skin/*.css, image/* などは PHP を通さずに返す
    "directory": "build/public"
  },
  "r2_buckets": [
    { "binding": "WIKI", "bucket_name": "denken-wiki" }
  ],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.so"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }
  ],
  "observability": { "enabled": true }
}
